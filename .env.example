# Names only. Copy to .env.local and fill in. Never commit real values.

# Neon Postgres (written by `neon init`; pooled for app requests, unpooled for migrations)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Gemini (used only inside the single LLM adapter, src/lib/llm/adapter.ts)
GEMINI_API_KEY=
# Model names are env vars, never literals in code. Starting values:
#   GEMINI_MODEL=gemini-2.5-flash-lite          (generation: extract, judge)
#   GEMINI_EMBEDDING_MODEL=gemini-embedding-001 (768 dimensions)
GEMINI_MODEL=
GEMINI_EMBEDDING_MODEL=

# Set to "dev" only in .env.development.local. Database tests and `npm run db:migrate`
# run only when this is "dev", so they never touch the main Neon branch.
NEON_BRANCH=
